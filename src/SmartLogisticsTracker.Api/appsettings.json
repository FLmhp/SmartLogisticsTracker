{
  "ConnectionStrings": {
    "Sqlite": "Data Source=smartlogistics-mvp.db",
    "PostgreSql": "Host=127.0.0.1;Port=5432;Database=smart_logistics_tracker;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoInitialize": true
  },
  "Jwt": {
    "Issuer": "SmartLogisticsTracker",
    "Audience": "SmartLogisticsTracker.Client",
    "SigningKey": "SmartLogisticsTracker_MVP_2026_ReplaceInProduction",
    "AccessTokenExpireMinutes": 120
  },
  "AlertRules": {
    "MinTemperatureC": -20,
    "MaxTemperatureC": 60,
    "MinHumidityRh": 10,
    "MaxHumidityRh": 85,
    "WarningShockG": 3,
    "CriticalShockG": 5,
    "AccelerationScale": 1000
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "TopicFilter": "tracker/+/telemetry",
    "ClientId": "smart-logistics-api-ingestor"
  },
  "DeviceMonitor": {
    "OfflineMinutes": 30,
    "CheckIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
